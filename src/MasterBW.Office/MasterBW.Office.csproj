<Project Sdk="Microsoft.NET.Sdk">
  <!-- Logika add-in Word & Excel (UI, eksekutor aksi). Dipanggil oleh proyek VSTO tipis MasterBW.Word / MasterBW.Excel. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>MasterBW.Office</RootNamespace>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Office.Interop.Word" Version="15.0.4797.1004" />
    <PackageReference Include="Microsoft.Office.Interop.Excel" Version="15.0.4795.1001" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="Microsoft.CSharp" />
    <EmbeddedResource Include="Ribbon\*.xml" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MasterBW.Core\MasterBW.Core.csproj" />
  </ItemGroup>
</Project>
