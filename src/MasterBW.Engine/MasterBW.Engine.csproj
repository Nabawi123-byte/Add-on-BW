<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Mesin AI lokal: llama.cpp (LLamaSharp) + Whisper offline, server HTTP di 127.0.0.1. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MasterBW.Engine</AssemblyName>
    <RootNamespace>MasterBW.Engine</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LLamaSharp" Version="0.30.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.30.0" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MasterBW.Core\MasterBW.Core.csproj" />
  </ItemGroup>
</Project>
