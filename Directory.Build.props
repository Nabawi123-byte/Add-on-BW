<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Company>MASTER BW</Company>
    <Product>MASTER BW - Asisten AI Offline untuk Word &amp; Excel</Product>
    <Version>1.0.0</Version>
    <Deterministic>true</Deterministic>
    <NoWarn>$(NoWarn);CS1591;NU1701;CA1416</NoWarn>
  </PropertyGroup>
</Project>
